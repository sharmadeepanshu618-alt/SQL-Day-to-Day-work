-- 31july-corerelated subquery


use corr_db;
create table orders1 (order_id int,name varchar(20),amount int);
insert into orders1 values (1,'a',100),(2,'a',200),(3,'a',300),(4,'d',400);
insert into orders1 values (5,'d',300);
select * from orders1;
show tables;
describe orders1;
select order_id,name,amount from orders1 where name='a' and amount=(select max(amount) from orders1 where name='a');

select order_id,name,amount from orders1 as o_outer where amount=(select max(amount) from orders1 where name=o_outer.name);





